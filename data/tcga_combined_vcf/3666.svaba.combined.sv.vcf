##INFO=<ID=MATEID,Number=1,Type=String,Description="ID of mate breakends">
##INFO=<ID=MAPQ,Number=1,Type=Integer,Description="Mapping quality (BWA-MEM) of this fragement of the contig (-1 if discordant only)">
