##FILTER=<ID=LOWSPLITSMALL,Description="Fewer than 4 split reads for small events ( < 1500 bp)">
##FILTER=<ID=LOWMAPQDISC,Description="Both clusters of reads failed to achieve mean mapq of > 30 for DSCRD">
